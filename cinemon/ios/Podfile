# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Fix DT_TOOLCHAIN_DIR warning
      xcconfig_path = config.base_configuration_reference.real_path
      xcconfig = File.read(xcconfig_path)
      xcconfig_mod = xcconfig.gsub(/DT_TOOLCHAIN_DIR/, "TOOLCHAIN_DIR")
      File.open(xcconfig_path, "w") { |file| file << xcconfig_mod }

      # Set minimum iOS deployment target to 13.0 for all pods
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'

      # Allow non-modular includes in framework modules (required for Firebase Flutter plugins)
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

      # Specifically fix firebase_auth, firebase_core, cloud_firestore Flutter plugins
      if ['firebase_auth', 'firebase_core', 'cloud_firestore'].include?(target.name)
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
      end

      # Fix gRPC/BoringSSL C++ compatibility with Xcode 26
      if ['gRPC-Core', 'gRPC-C++', 'BoringSSL-GRPC', 'abseil'].include?(target.name)
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '$(inherited) -Wno-comma -Wno-shorten-64-to-32 -Wno-error'
      end

      # Fix abseil linking issues
      if target.name == 'abseil'
        config.build_settings['OTHER_LDFLAGS'] = '$(inherited) -ObjC'
      end
    end
  end

  # Fix BoringSSL-GRPC compiler flags for Xcode 26
  installer.pods_project.targets.each do |target|
    if target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        if file.settings && file.settings['COMPILER_FLAGS']
          flags = file.settings['COMPILER_FLAGS']
          flags = flags.gsub(/-G\s*/, '')
          flags = flags.gsub(/\$\(CC_WARN_INHIBIT_ALL_WARNINGS\)/, '-w')
          flags = flags.gsub(/CC_WARN_INHIBIT_ALL_WARNINGS/, '')
          file.settings['COMPILER_FLAGS'] = flags
        end
      end
    end
  end

  # Patch gRPC template syntax for Xcode 26 Clang compatibility
  ['gRPC-Core', 'gRPC-C++'].each do |pod_name|
    grpc_path = "#{installer.sandbox.root}/#{pod_name}"
    basic_seq_file = "#{grpc_path}/src/core/lib/promise/detail/basic_seq.h"
    if File.exist?(basic_seq_file)
      content = File.read(basic_seq_file)
      # Fix template keyword usage that newer Clang rejects
      content = content.gsub(/Traits::template\s+CallSeqFactory\s*\(/, 'Traits::CallSeqFactory(')
      content = content.gsub(/Traits::template\s+CallFactory\s*\(/, 'Traits::CallFactory(')
      File.open(basic_seq_file, "w") { |file| file << content }
    end
  end
end
